{
  "name": "koinos-pq-wallet",
  "version": "0.2.1",
  "private": true,
  "description": "Post-quantum (ML-DSA-44) wallet for Koinos: web app and browser extension (window.kondor compatible) on one signing core",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/write-version.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "build:ext": "tsc --noEmit && vite build -c vite.ext-pages.config.ts && vite build -c vite.ext-content.config.ts && vite build -c vite.ext-inpage.config.ts",
    "e2e:ext": "node --experimental-strip-types scripts/e2e-extension.mjs",
    "smoke:web": "node --experimental-strip-types scripts/smoke-web.mjs",
    "icons": "node scripts/make-icons.mjs"
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0",
    "@noble/post-quantum": "^0.7.1",
    "koilib": "^9.4.1",
    "koinos-pq-core": "git+https://github.com/Justyoureverydaynormalguybob/koinos-pq-core.git#214d23e",
    "kondor-js": "^1.3.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.5",
    "@types/qrcode": "^1.5.5",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  },
  "license": "MIT"
}
