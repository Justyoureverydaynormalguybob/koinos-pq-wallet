{
  "name": "koinos-pq-wallet",
  "version": "0.12.2",
  "private": true,
  "description": "Post-quantum (ML-DSA-44) wallet for Koinos: web app and browser extension (window.kondor compatible) on one signing core",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:inpage && tsc --noEmit && vite build && node scripts/write-version.mjs",
    "preview": "vite preview",
    "test": "npm run build:inpage && vitest run",
    "build:ext": "tsc --noEmit && vite build -c vite.ext-pages.config.ts && vite build -c vite.ext-content.config.ts && vite build -c vite.ext-inpage.config.ts",
    "e2e:ext": "node --experimental-strip-types scripts/e2e-extension.mjs",
    "smoke:web": "node --experimental-strip-types scripts/smoke-web.mjs",
    "icons": "node scripts/make-icons.mjs",
    "e2e:activation": "node --experimental-strip-types scripts/e2e-activation.mjs",
    "build:inpage": "vite build -c vite.ext-inpage.config.ts"
  },
  "dependencies": {
    "@aparajita/capacitor-biometric-auth": "^10.0.0",
    "@aparajita/capacitor-secure-storage": "^8.0.1",
    "@capacitor/android": "^8.0.0",
    "@capacitor/app": "^8.0.0",
    "@capacitor/barcode-scanner": "^3.1.3",
    "@capacitor/cli": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/ios": "^8.0.0",
    "@noble/hashes": "^2.4.0",
    "@noble/post-quantum": "^0.7.1",
    "koilib": "^9.4.1",
    "koinos-pq-core": "github:Justyoureverydaynormalguybob/koinos-pq-core#f97139c",
    "kondor-js": "^1.3.0",
    "pq-browser": "file:plugins/pq-browser",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.5",
    "@types/qrcode": "^1.5.5",
    "jsdom": "^26.1.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  },
  "license": "MIT"
}
