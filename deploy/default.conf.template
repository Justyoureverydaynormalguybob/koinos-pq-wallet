server {
    listen ${PORT};
    server_name _;
    root /usr/share/nginx/html;
    index index.html;
    include /etc/nginx/headers.conf;
    # Behind Railway and Cloudflare, nginx only sees its own http://host:$PORT. An absolute redirect
    # (e.g. /demo -> /demo/) would send browsers to http://wallet.koinosproof.com:8080/demo/, so keep
    # redirects relative and let the browser resolve them against the address it actually used.
    absolute_redirect off;

    location = /health {
        include /etc/nginx/headers.conf;
        default_type text/plain;
        return 200 "ok\n";
    }

    # hashed build assets: cache for a year
    location /assets/ {
        include /etc/nginx/headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    # pages and the version file: always revalidate, so a new deploy shows up on the next load
    location / {
        include /etc/nginx/headers.conf;
        add_header Cache-Control "no-cache" always;
        try_files $uri $uri/ =404;
    }
}
